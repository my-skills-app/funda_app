<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>

    <style name="AppTheme.FullScreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Edge-to-edge Reels: status bar stays visible; solid black so prior activity never shows through. -->
    <style name="AppTheme.Reels" parent="AppTheme">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Custom theme for a completely dark dialog -->
    <style name="DarkDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <!-- Set the custom rounded background -->
    <item name="android:windowBackground">@drawable/rounded_dialog_bg</item>
    
    <!-- Maintain other styling -->
    <item name="backgroundColor">#000000</item>
    <item name="android:textColorPrimary">#FFFFFF</item>
    <item name="android:textColorSecondary">#B3FFFFFF</item>
    <item name="alertDialogTheme">@style/DarkAlertDialogStyle</item>
</style>

    <!-- Additional custom style for the AlertDialog title and message text colors -->
    <style name="DarkAlertDialogStyle" parent="Theme.Material3.DayNight.Dialog.Alert">
        <!-- Set the title color -->
        <item name="android:textColorPrimary">#FFFFFF</item>
        <!-- Set the message text color -->
        <item name="android:textColorSecondary">#B3FFFFFF</item>
    </style>
    
    <style name="NumberInPasscode">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/layout_selector_tran</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_black</item>
    </style>
    
    <style name="CustomDialogTheme" parent="Theme.AppCompat.Dialog">
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowNoTitle">true</item>
</style>

    <style name="VideoQualityBottomSheetTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/VideoQualityBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/colorPrimary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="VideoQualityBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="shapeAppearanceOverlay">@style/VideoQualityBottomSheetShape</item>
    </style>

    <style name="VideoQualityBottomSheetShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
    </style>

    <!-- PiP host: black surface so video is not transparent in the floating window. -->
    <style name="PromoAdPipTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Home-aligned Gita typography -->
    <style name="GitaTextScreenTitle">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:fontFamily">@font/outfit_semi_bold</item>
    </style>

    <style name="GitaTextSubtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_color_light</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
    </style>

    <style name="GitaTextSectionTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:fontFamily">@font/outfit_semi_bold</item>
    </style>

    <style name="GitaTextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/text_color_light</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
    </style>

    <style name="GitaTextCardTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/outfit_semi_bold</item>
    </style>

    <style name="GitaTextCardDescription">
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">#CCDDDDDD</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
    </style>

    <style name="GitaTextWatchButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/outfit_semi_bold</item>
    </style>

    <style name="GitaTextSplashPoweredBy">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_color_light</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="GitaTextSplashBrand">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/outfit_semi_bold</item>
        <item name="android:gravity">center</item>
    </style>
</resources>