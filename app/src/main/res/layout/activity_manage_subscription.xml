<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/manage_subscription_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/manage_subscription_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/back_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_toolbar_back_btn"
                android:contentDescription="@string/back"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/arrow_back_24"
                app:tint="@color/text_color" />

            <TextView
                style="@style/GitaTextScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/manage_subscription_title" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/manage_scroll_inner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/GitaTextSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manage_total_users_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_total_users_count"
                            style="@style/GitaTextScreenTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/manage_total_users_loading"
                            android:textColor="@color/text_color" />

                        <TextView
                            style="@style/GitaTextSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/manage_total_users_hint"
                            android:textColor="@color/text_color_light" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/GitaTextSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/manage_app_settings_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/GitaTextBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_semi_bold"
                            android:text="@string/manage_premium_enabled_title"
                            android:textColor="@color/text_color" />

                        <TextView
                            style="@style/GitaTextSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/manage_premium_enabled_hint"
                            android:textColor="@color/text_color_light" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_premium_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    style="@style/GitaTextSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/manage_app_update_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/GitaTextBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/manage_app_update_enabled"
                            android:textColor="@color/text_color" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_update_enabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/edit_update_version"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:hint="@string/manage_app_update_version_hint"
                        android:inputType="text"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint" />

                    <EditText
                        android:id="@+id/edit_update_title"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:hint="@string/manage_app_update_title_hint"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint" />

                    <EditText
                        android:id="@+id/edit_update_message"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:gravity="top|start"
                        android:hint="@string/manage_app_update_message_hint"
                        android:inputType="textMultiLine"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint" />

                    <EditText
                        android:id="@+id/edit_update_url"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:hint="@string/manage_app_update_url_hint"
                        android:inputType="textUri"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/GitaTextBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/manage_app_update_force"
                            android:textColor="@color/text_color" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_update_force"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_save_app_settings"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_auth_primary_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/outfit_medium"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:text="@string/manage_app_settings_save"
                        android:textColor="@color/text_color"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    style="@style/GitaTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/manage_subscription_hint"
                    android:textColor="@color/text_color_light" />

                <TextView
                    style="@style/GitaTextSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/manage_subscription_plans_title" />

                <LinearLayout
                    android:id="@+id/admin_plans_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    style="@style/GitaTextSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/manage_subscription_add_plan" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <EditText
                        android:id="@+id/edit_plan_id"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:hint="@string/manage_plan_id_hint"
                        android:inputType="textNoSuggestions"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint" />

                    <EditText
                        android:id="@+id/edit_plan_title"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:hint="@string/manage_plan_title_hint"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint" />

                    <EditText
                        android:id="@+id/edit_plan_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:hint="@string/manage_plan_subtitle_hint"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint" />

                    <EditText
                        android:id="@+id/edit_plan_price"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:hint="@string/manage_plan_price_hint"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint" />

                    <EditText
                        android:id="@+id/edit_plan_badge"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:hint="@string/manage_plan_badge_hint"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint" />

                    <TextView
                        android:id="@+id/btn_add_plan"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_auth_primary_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/outfit_medium"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:text="@string/manage_subscription_add_button"
                        android:textColor="@color/text_color"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
