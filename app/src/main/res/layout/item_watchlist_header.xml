    <TextView
        android:id="@+id/txtWatchlistHeaderSubtitle"
        style="@style/GitaTextSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="3 saved shlokas" />
</LinearLayout>
