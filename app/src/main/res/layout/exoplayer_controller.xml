<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:background="#98000000"
        android:layout_height="0dp" />


    <LinearLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_toolbar_back_btn"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/arrow_back_24"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/file_name_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_semi_bold"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="Shloka 2.1" />

    </LinearLayout>


    <FrameLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:layout_marginTop="10dp"
        android:layoutDirection="ltr">

        <LinearLayout
            android:id="@id/exo_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layoutDirection="ltr"
            android:paddingStart="10dp"
            android:paddingLeft="10dp"
            android:paddingEnd="10dp"
            android:paddingRight="10dp">

            <TextView
                android:id="@id/exo_position"
                style="@style/ExoStyledControls.TimeText.Position" />

            <TextView style="@style/ExoStyledControls.TimeText.Separator" />

            <TextView
                android:id="@id/exo_duration"
                style="@style/ExoStyledControls.TimeText.Duration" />

        </LinearLayout>

        <LinearLayout
            android:id="@id/exo_basic_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layoutDirection="ltr">

            <ImageButton
                android:id="@+id/more_videos_btn"
                style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"
                android:src="@drawable/ic_playlist"
                android:visibility="gone"
                tools:ignore="ContentDescription"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/screen_rotate_btn"
                style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"
                android:src="@drawable/screen_rotation_24"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/pip_btn"
                style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"
                android:src="@drawable/more_pip_icon"
                android:contentDescription="@string/player_pip" />

            <ImageButton
                android:id="@+id/fit_screen_btn"
                style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"
                android:src="@drawable/crop_free"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/quality_selection_btn"
                style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"
                android:src="@drawable/outline_hd_24"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@id/exo_subtitle"
                style="@style/ExoStyledControls.Button.Bottom.CC"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@id/exo_settings"
                style="@style/ExoStyledControls.Button.Bottom.Settings"
                tools:ignore="ContentDescription" />

        </LinearLayout>

        <HorizontalScrollView
            android:id="@id/exo_extra_controls_scroll_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:visibility="invisible">

            <LinearLayout
                android:id="@id/exo_extra_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr">

                <ImageButton
                    android:id="@id/exo_overflow_hide"
                    style="@style/ExoStyledControls.Button.Bottom.OverflowHide"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

        </HorizontalScrollView>

    </FrameLayout>

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="7dp"
        android:layout_marginBottom="52dp"
        app:bar_height="3dp"
        app:buffered_color="#424242"
        app:played_color="#FFFF0000"
        app:scrubber_color="#FFFF0000"
        app:scrubber_enabled_size="25dp"
        app:unplayed_color="#424242" />

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:gravity="center"
        android:padding="24dp">


        <ImageButton
            android:id="@+id/backward_10"
            android:src="@drawable/replay_10_24"
            android:layout_marginHorizontal="50dp"
            style="@style/ExoStyledControls.Button.Center.PlayPause"
            android:contentDescription="Skip 10 seconds backward"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@id/exo_play_pause"
            style="@style/ExoStyledControls.Button.Center.PlayPause"
            android:layout_marginHorizontal="10dp"
            android:contentDescription="Play or Pause"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/forward_10"
            android:src="@drawable/forward_10_24"
            android:layout_marginHorizontal="50dp"
            style="@style/ExoStyledControls.Button.Center.PlayPause"
            android:contentDescription="Skip 10 seconds forward"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</merge>
