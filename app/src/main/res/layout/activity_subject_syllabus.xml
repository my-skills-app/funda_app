<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshSyllabus"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_glass">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/imgSubjectBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription"
                    tools:src="@color/view_bg_color" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_syllabus_hero_scrim" />

                <LinearLayout
                    android:id="@+id/layoutSyllabusTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_toolbar_back_btn"
                        android:contentDescription="@string/back"
                        android:padding="11dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/arrow_back_24"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/chipExam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_syllabus_exam_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:id="@+id/imgExamThumb"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/default_image" />

                            <TextView
                                android:id="@+id/txtExamChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/outfit_medium"
                                android:includeFontPadding="false"
                                android:maxWidth="200dp"
                                android:maxLines="1"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                tools:text="SSC CHSL • Full Course" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnShare"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_toolbar_back_btn"
                        android:contentDescription="@string/share"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_share"
                        android:visibility="invisible"
                        app:tint="@color/white"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSubjectTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:fontFamily="@font/outfit_semi_bold"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="28dp"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    tools:text="Quantitative Aptitude" />
            </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-12dp"
                    android:background="@drawable/bg_syllabus_sheet"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:minHeight="420dp"
                    android:orientation="vertical"
                    android:paddingTop="18dp"
                    android:paddingBottom="28dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSyllabusGroups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ProgressBar
                    android:id="@+id/progressSyllabus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="48dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/txtSyllabusError"
                    style="@style/GitaTextSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="28dp"
                    android:text="@string/prep_syllabus_load_error"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
