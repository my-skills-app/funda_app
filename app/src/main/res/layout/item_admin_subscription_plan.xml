<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/text_admin_plan_title"
        style="@style/GitaTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_semi_bold"
        android:textColor="@color/text_color"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/text_admin_plan_meta"
        style="@style/GitaTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_color_light"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btn_remove_plan"
        style="@style/GitaTextBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/outfit_medium"
        android:padding="4dp"
        android:text="@string/manage_subscription_remove_plan"
        android:textColor="@color/app_color" />
</LinearLayout>
