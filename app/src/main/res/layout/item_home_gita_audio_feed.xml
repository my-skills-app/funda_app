<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutFullGitaAudioSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <View
            android:layout_width="4dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_section_accent" />

        <TextView
            android:id="@+id/txtFullGitaAudioSectionTitle"
            style="@style/GitaTextSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/home_full_gita_audio_section_title" />
    </LinearLayout>

    <include
        android:id="@+id/layoutFullGitaAudio"
        layout="@layout/layout_home_full_audio_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp" />

</LinearLayout>
