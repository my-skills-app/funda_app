<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_series_topic_row"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/rowTopicMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtTopicIndex"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semi_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/text_color_light"
            android:textSize="15sp"
            tools:text="1" />

        <FrameLayout
            android:id="@+id/frameTopicThumb"
            android:layout_width="72dp"
            android:layout_height="96dp"
            android:layout_marginStart="6dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgTopicThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_series_topic_thumb"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txtTopicBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="5dp"
                android:background="@drawable/bg_prep_pyq_badge"
                android:fontFamily="@font/outfit_semi_bold"
                android:includeFontPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:visibility="gone"
                tools:text="1 PYQ"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTopicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_semi_bold"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/text_color"
                android:textSize="14sp"
                tools:text="Stone to Civilisation: Start Here" />

            <TextView
                android:id="@+id/txtTopicDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/outfit_regular"
                android:includeFontPadding="false"
                android:textColor="@color/text_color_light"
                android:textSize="12sp"
                tools:text="1min" />

            <ProgressBar
                android:id="@+id/progressTopic"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_series_topic" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/frameDownloadTopic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp">

            <ProgressBar
                android:id="@+id/progressDownloadTopic"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_download_circle"
                android:visibility="gone"
                tools:progress="45"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/btnDownloadTopic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_series_download_circle"
                android:contentDescription="@string/prep_download_video"
                android:padding="9dp"
                android:src="@drawable/ic_download_box"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/txtDownloadPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="#CC100A0E"
                android:fontFamily="@font/outfit_semi_bold"
                android:includeFontPadding="false"
                android:paddingStart="3dp"
                android:paddingTop="1dp"
                android:paddingEnd="3dp"
                android:paddingBottom="1dp"
                android:textColor="@color/app_color"
                android:textSize="9sp"
                android:visibility="gone"
                tools:text="45%"
                tools:visibility="visible" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btnPlayTopic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_series_play_circle"
            android:contentDescription="@string/prep_play_topic"
            android:padding="9dp"
            android:src="@drawable/play_arrow_24"
            app:tint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnTopicExamplesToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/txtTopicExamplesToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semi_bold"
            android:includeFontPadding="false"
            android:textColor="@color/app_color"
            android:textSize="13sp"
            tools:text="1 example" />

        <ImageView
            android:id="@+id/iconTopicExamplesChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/app_color"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelTopicExamples"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_series_examples_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/txtTopicExamplesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semi_bold"
            android:includeFontPadding="false"
            android:text="@string/prep_topic_examples"
            android:textColor="@color/text_color"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutTopicExamples"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
