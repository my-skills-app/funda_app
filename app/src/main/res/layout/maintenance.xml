<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="350dp"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/round"
        android:backgroundTint="@color/app_black">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:background="@drawable/bg_stoke_25"
            android:backgroundTint="@color/et_stroke_color"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="25dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/maintenance"
                app:tint="@color/app_color" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/outfit_semi_bold"
                android:gravity="center"
                android:textColor="@color/text_color"
                android:textSize="@dimen/_18sp" />

            <TextView
                android:id="@+id/message_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:alpha="0.7"
                android:fontFamily="@font/outfit_regular"
                android:gravity="center"
                android:text="@string/do_you_really_want_to_log_out_from_this_app"
                android:textColor="@color/text_color_light"
                android:textSize="@dimen/_14sp" />

            <TextView
                android:id="@+id/btn_ok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_for_edit_text_13"
                android:backgroundTint="@color/app_color"
                android:fontFamily="@font/outfit_semi_bold"
                android:gravity="center"
                android:paddingVertical="15dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sp" />

        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/btn_cancel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentEnd="true">

    </LinearLayout>
</RelativeLayout>