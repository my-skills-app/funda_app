<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/update_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/text_update_title"
            style="@style/GitaTextScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/app_update_default_title" />

        <TextView
            android:id="@+id/text_update_message"
            style="@style/GitaTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/app_update_default_message"
            android:textColor="@color/text_color_light" />

        <TextView
            android:id="@+id/btn_update_now"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_auth_primary_btn"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/outfit_medium"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/app_update_button"
            android:textColor="@color/text_color"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_update_later"
            style="@style/GitaTextBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/outfit_medium"
            android:padding="12dp"
            android:text="@string/app_update_later"
            android:textColor="@color/app_color" />
    </LinearLayout>
</FrameLayout>
