<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_glass">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSeriesDetails"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Compact banner only — CTAs live below so they never get clipped -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:id="@+id/imgSeriesBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription"
                    tools:src="@color/view_bg_color" />

                <View
                    android:id="@+id/viewSeriesScrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_syllabus_hero_scrim" />

                <LinearLayout
                    android:id="@+id/layoutSeriesTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_toolbar_back_btn"
                        android:contentDescription="@string/back"
                        android:padding="11dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/arrow_back_24"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/chipExam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_syllabus_exam_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:id="@+id/imgExamThumb"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop"
                                android:src="@drawable/default_image" />

                            <TextView
                                android:id="@+id/txtExamChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/outfit_medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                tools:text="RRB ALP" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnShare"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_toolbar_back_btn"
                        android:contentDescription="@string/share"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/share_24"
                        app:tint="@color/white" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layoutHeroContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/txtBreadcrumb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_color_40"
                    android:textSize="12sp"
                    tools:text="Ancient India > Stone to Civilisation…" />

                <TextView
                    android:id="@+id/txtSeriesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/outfit_semi_bold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    tools:text="Stone to Civilisation: India's First Steps" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutContentChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/txtProgressLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/outfit_medium"
                    android:includeFontPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_color"
                    android:textSize="12sp"
                    tools:text="0/36 topics completed" />

                <ProgressBar
                    android:id="@+id/progressSeries"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_series_hero" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/btnWatchSeries"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_series_watch_btn"
                        android:fontFamily="@font/outfit_semi_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/prep_watch_video_series"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnBookmark"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_series_bookmark_btn"
                        android:contentDescription="@string/prep_bookmark"
                        android:padding="12dp"
                        android:src="@drawable/ic_bookmark_not"
                        app:tint="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_series_sheet"
                android:minHeight="420dp"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:id="@+id/layoutTabBar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_series_tab_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <LinearLayout
                        android:id="@+id/tabVideo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_series_tab_selected"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconTabVideo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_play_circle"
                            app:tint="@color/white"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/txtTabVideo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/outfit_semi_bold"
                            android:includeFontPadding="false"
                            android:text="@string/prep_tab_video"
                            android:textColor="@color/white"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tabAudio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconTabAudio"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_notification_audio"
                            app:tint="@color/text_color_light"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/txtTabAudio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/outfit_medium"
                            android:includeFontPadding="false"
                            android:text="@string/prep_tab_audio"
                            android:textColor="@color/text_color_light"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tabMindMap"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconTabMindMap"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_playlist"
                            app:tint="@color/text_color_light"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/txtTabMindMap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/outfit_medium"
                            android:includeFontPadding="false"
                            android:text="@string/prep_tab_mindmap"
                            android:textColor="@color/text_color_light"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/outfit_semi_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_color"
                    android:textSize="17sp"
                    tools:text="Theoretical Topics (36)" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTopics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_series_topic" />

                <!-- Inline loader for Video ↔ Audio tab switches (not full-screen) -->
                <ProgressBar
                    android:id="@+id/progressTopicsInline"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/series_accent_dark"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <WebView
                    android:id="@+id/webMindMap"
                    android:layout_width="match_parent"
                    android:layout_height="520dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtSeriesError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/prep_series_load_error"
                    android:textColor="@color/text_color_light"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Full-screen black loader (initial open only) -->
    <FrameLayout
        android:id="@+id/layoutSeriesLoader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorPrimary"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieSeriesLoader"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:scaleType="fitCenter"
                app:lottie_autoPlay="true"
                app:lottie_fileName="anim2.json"
                app:lottie_loop="true" />

            <!-- Kept for Java refs; Lottie is the visible custom loader -->
            <ProgressBar
                android:id="@+id/progressSeriesLoad"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtSeriesLoaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit_semi_bold"
                android:includeFontPadding="false"
                android:text="@string/prep_loader_relax"
                android:textColor="@color/white"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/txtSeriesLoaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/prep_loader_learning"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
