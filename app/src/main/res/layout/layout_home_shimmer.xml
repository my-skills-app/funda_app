<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:visibility="gone"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.55"
    app:shimmer_direction="left_to_right"
    app:shimmer_duration="1100"
    app:shimmer_highlight_alpha="0.95"
    app:shimmer_tilt="18">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/item_shimmer_home_shloka_day" />

        <include layout="@layout/item_shimmer_home_section" />

        <include layout="@layout/item_shimmer_home_banner" />

        <include layout="@layout/item_shimmer_home_section" />

        <include layout="@layout/item_shimmer_home_section" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
