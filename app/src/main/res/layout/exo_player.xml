<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<RelativeLayout
		android:id="@+id/rl1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#111111"
		android:orientation="vertical"
		android:keepScreenOn="true">

		<androidx.media3.ui.PlayerView
			android:id="@+id/playerView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			app:show_buffering="when_playing"
			app:show_shuffle_button="false"
			app:show_subtitle_button="true"
			app:controller_layout_id="@layout/exoplayer_controller"
			android:background="#000000" />

		<ImageView
			android:id="@+id/audio_artwork"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:contentDescription="@string/play"
			android:scaleType="centerCrop"
			android:visibility="gone" />

		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="15dp"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/brightness_volume_container"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="5dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				
				android:background="@drawable/round_corner"
				android:visibility="gone">
				<ImageView
					android:id="@+id/volume_icon"
					android:layout_width="25dp"
					android:layout_height="25dp"
					android:src="@drawable/default_image"
					android:scaleType="fitCenter"
					android:adjustViewBounds="true"
					android:visibility="gone" />
				<ImageView
					android:id="@+id/brightness_icon"
					android:layout_width="25dp"
					android:layout_height="25dp"
					android:src="@drawable/default_image"
					android:scaleType="fitCenter"
					android:adjustViewBounds="true"
					android:visibility="gone" />
				<TextView
					android:id="@+id/brightness_volume_tv"
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:text="100"
					android:textSize="16sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF"
					android:layout_marginStart="5dp"
					android:visibility="gone" />
				<ProgressBar
					android:id="@+id/progressbar1"
					android:layout_width="200dp"
					android:layout_height="10dp"
					android:indeterminate="false"
					style="?android:progressBarStyleHorizontal"
					android:progressDrawable="@drawable/custom_brightness_seekbar" />
			</LinearLayout>
		</LinearLayout>
	</RelativeLayout>
</LinearLayout>
