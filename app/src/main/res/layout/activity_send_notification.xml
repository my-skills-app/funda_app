<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/send_notification_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_glass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/send_notification_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/back_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_toolbar_back_btn"
                android:contentDescription="@string/back"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/arrow_back_24"
                app:tint="@color/text_color" />

            <TextView
                style="@style/GitaTextScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/send_notification_title" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/scroll_content_inner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/GitaTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/send_notification_hint"
                    android:textColor="@color/text_color_light" />

                <TextView
                    style="@style/GitaTextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/outfit_semi_bold"
                    android:text="@string/send_notification_section_message"
                    android:textColor="@color/text_color"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/GitaTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/send_notification_field_title"
                        android:textColor="@color/text_color_light"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edit_title"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:hint="@string/send_notification_title_hint"
                        android:inputType="textCapSentences"
                        android:maxLines="2"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/GitaTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/send_notification_field_body"
                        android:textColor="@color/text_color_light"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edit_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:gravity="top"
                        android:hint="@string/send_notification_body_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="4"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/GitaTextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/outfit_semi_bold"
                    android:text="@string/send_notification_section_media"
                    android:textColor="@color/text_color"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:id="@+id/frame_image_pick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:id="@+id/img_preview"
                            android:layout_width="match_parent"
                            android:layout_height="176dp"
                            android:contentDescription="@string/send_notification_image_preview"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layout_pick_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="176dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_add_image"
                                app:tint="@color/app_color" />

                            <TextView
                                android:id="@+id/text_no_image"
                                style="@style/GitaTextBody"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/send_notification_tap_add_image"
                                android:textColor="@color/text_color_light" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/btn_remove_image"
                        style="@style/GitaTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/outfit_medium"
                        android:padding="4dp"
                        android:text="@string/send_notification_remove_image"
                        android:textColor="@color/app_color"
                        android:visibility="gone" />

                    <TextView
                        style="@style/GitaTextBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/send_notification_field_link"
                        android:textColor="@color/text_color_light"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edit_link"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_for_edit_text_13"
                        android:hint="@string/send_notification_link_hint"
                        android:inputType="textUri"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/text_color"
                        android:textColorHint="@color/text_color_hint"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/GitaTextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/outfit_semi_bold"
                    android:text="@string/send_notification_target_label"
                    android:textColor="@color/text_color"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp">

                    <RadioGroup
                        android:id="@+id/radio_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/radio_all_users"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/radio_app_color_tint"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/send_notification_target_all"
                            android:textColor="@color/text_color"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@color/view_bg_color" />

                        <RadioButton
                            android:id="@+id/radio_this_device"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/radio_app_color_tint"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/send_notification_target_device"
                            android:textColor="@color/text_color"
                            android:textSize="15sp" />
                    </RadioGroup>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_send"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_auth_primary_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/outfit_medium"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/send_notification_button"
                    android:textColor="@color/text_color"
                    android:textSize="18sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlay_sending"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_black_70"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/app_color" />
    </FrameLayout>
</FrameLayout>
