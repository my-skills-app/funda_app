<?xml version="1.0" encoding="utf-8"?>
<!-- Soft black shadow plate under the Netflix banner card -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:top="10dp"
        android:right="4dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#99000000" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:top="16dp"
        android:right="10dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#66000000" />
        </shape>
    </item>
    <item android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FF0A0A0A" />
        </shape>
    </item>
</layer-list>
