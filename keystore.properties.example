# Copy to keystore.properties and fill in your release keystore details.
# Generate keystore: keytool -genkey -v -keystore bhagavat-gita-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias bhagavat-gita
storeFile=bhagavat-gita-release.jks
storePassword=your_store_password
keyAlias=bhagavat-gita
keyPassword=your_key_password
